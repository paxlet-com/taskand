#!/bin/sh
# taskand CLI — interfejs linii poleceń do zarządzania systemem taskand
set -eu

# Znajdź katalog projektu (tam gdzie znajduje się docker-compose.yaml)
PROJECT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
[ -f "$PROJECT_DIR/docker-compose.yaml" ] || PROJECT_DIR="$(pwd)"

INBOX="$PROJECT_DIR/tasks/inbox.yaml"
DONE="$PROJECT_DIR/tasks/done.yaml"

call_organism() {
  ORG="$1"
  MSG="$2"
  # 1. Sprawdź czy gateway działa
  if curl -s -f http://localhost:8077/health >/dev/null 2>&1; then
    RESP=$(curl -s -X POST "http://localhost:8077/api/organism/$ORG/chat" \
      -H "Content-Type: application/json" \
      -d "{\"message\": $(printf '%s' "$MSG" | python3 -c 'import sys, json; print(json.dumps(sys.stdin.read()))')}")
    printf '%s\n' "$RESP" | python3 -c '
import sys, json
raw = sys.stdin.read().strip()
try:
    data = json.loads(raw)
    print(data.get("reply") or data.get("response") or data.get("output") or data)
except Exception:
    print(raw)
'
  else
    # 2. Fallback do bezpośredniego wykonania procesu w node
    case "$ORG" in
      dev|developer)
        BIN="$PROJECT_DIR/packages/developer/proc/dev/chat/taskand.dev/v1/bin.mjs"
        ;;
      doc|doctor)
        BIN="$PROJECT_DIR/packages/doctor/proc/doctor/chat/taskand.dev/v1/bin.mjs"
        ;;
      sec|vault)
        BIN="$PROJECT_DIR/packages/vault/proc/vault/chat/taskand.dev/v1/bin.mjs"
        ;;
      chat|c)
        BIN="$PROJECT_DIR/packages/chat/proc/chat/message/taskand.dev/v1/bin.mjs"
        ;;
      *)
        echo "Nieznany organizm: $ORG"
        exit 1
        ;;
    esac
    if [ -f "$BIN" ]; then
      export TASKAND_ROOT="$PROJECT_DIR"
      printf '{"message": %s}\n' "$(printf '%s' "$MSG" | python3 -c 'import sys, json; print(json.dumps(sys.stdin.read()))')" | node "$BIN" | python3 -c '
import sys, json
try:
    data = json.load(sys.stdin)
    print(data.get("reply") or data.get("text") or data.get("output") or data)
except Exception:
    print(sys.stdin.read())
'
    else
      echo "Błąd: nie znaleziono pliku procesu $BIN"
      exit 1
    fi
  fi
}

cmd="${1:-}"

case "$cmd" in
  dev|developer)
    shift || true
    MSG="${*:-}"
    if [ -z "$MSG" ]; then
      echo "Użycie: taskand dev \"<polecenie/prompt>\""
      echo "Przykłady:"
      echo "  taskand dev \"dozbrój nginx na :8090\""
      echo "  taskand dev \"stwórz nowy proces proc://taskand.dev/auth/v1\""
      exit 1
    fi
    call_organism "dev" "$MSG"
    ;;
  doc|doctor)
    shift || true
    MSG="${*:-sprawdź stan całego systemu}"
    call_organism "doc" "$MSG"
    ;;
  sec|vault)
    shift || true
    MSG="${*:-}"
    if [ -z "$MSG" ]; then
      echo "Użycie: taskand sec \"<polecenie/prompt>\""
      echo "Przykłady:"
      echo "  taskand sec \"migruj token llm do vaulta\""
      echo "  taskand sec \"audyt uprawnień\""
      exit 1
    fi
    call_organism "sec" "$MSG"
    ;;
  chat|c)
    shift || true
    MSG="${*:-}"
    if [ -z "$MSG" ]; then
      echo "Użycie: taskand chat \"<wiadomość>\""
      exit 1
    fi
    call_organism "chat" "$MSG"
    ;;
  arm)
    shift || true
    SRV="${1:-nginx}"
    PORT="${2:-8090}"
    call_organism "dev" "dozbrój $SRV na :$PORT"
    ;;
  fed|federation)
    if curl -s -f http://localhost:8077/federation >/dev/null 2>&1; then
      curl -s http://localhost:8077/federation | python3 -m json.tool
    else
      echo "=== Lokalne rejestry federacji (proc-catalog.json) ==="
      for p in "$PROJECT_DIR"/packages/*/proc-catalog.json; do
        if [ -f "$p" ]; then
          pkg_name="$(basename "$(dirname "$p")")"
          echo "[$pkg_name]:"
          python3 -c 'import sys, json; b=json.load(open(sys.argv[1])).get("bindings", []); [print(f"  - {x.get(\"uri\")}") for x in b]' "$p"
        fi
      done
    fi
    ;;
  proc)
    shift || true
    URI="${1:-}"
    DATA="${2:-{}}"
    if [ -z "$URI" ]; then
      echo "Użycie: taskand proc <uri> [json_payload]"
      exit 1
    fi
    if curl -s -f http://localhost:8077/health >/dev/null 2>&1; then
      curl -s -X POST http://localhost:8077/api/proc \
        -H "Content-Type: application/json" \
        -d "{\"uri\":\"$URI\",\"data\":$DATA}" | python3 -m json.tool
    else
      python3 -c '
import sys, json, os, subprocess
uri = sys.argv[1]
data = json.loads(sys.argv[2])
root = sys.argv[3]
target_bin = None
for p in [os.path.join(root, "proc-catalog.json")] + [os.path.join(root, "packages", d, "proc-catalog.json") for d in os.listdir(os.path.join(root, "packages")) if os.path.isdir(os.path.join(root, "packages", d))]:
    if os.path.exists(p):
        cat = json.load(open(p))
        base_d = os.path.dirname(p)
        for b in cat.get("bindings", []):
            if b.get("uri") == uri:
                target_bin = os.path.join(base_d, b.get("path"), "bin.mjs")
                break
    if target_bin: break
if not target_bin or not os.path.exists(target_bin):
    print(json.dumps({"ok": False, "error": f"Nie znaleziono {uri}"}))
    sys.exit(1)
res = subprocess.run(["node", target_bin], input=json.dumps(data), text=True, capture_output=True)
try:
    print(json.dumps(json.loads(res.stdout), indent=2))
except:
    print(res.stdout)
' "$URI" "$DATA" "$PROJECT_DIR"
    fi
    ;;
  add)
    shift || true
    TYP=""
    FOLLOW=1
    while [ $# -gt 0 ]; do
      case "$1" in
        -t|--typ)
          TYP="$2"
          shift 2
          ;;
        -d|--async|--no-follow)
          FOLLOW=0
          shift
          ;;
        -f|--follow)
          FOLLOW=1
          shift
          ;;
        *)
          break
          ;;
      esac
    done
    ZADANIE="${*:-}"
    if [ -z "$ZADANIE" ]; then
      echo "Użycie: taskand add [-t <typ>] [-d|--async] \"opis zadania\""
      echo "Domyślny typ: rozpoznawany automatycznie ze zdania (czyszczenie, github-projekt, obserwuj, handover)"
      echo "Domyślnie: śledzenie logów na żywo (użyj -d dla działania w tle)"
      exit 1
    fi

    # Automatyczna analiza intencji ze zdania (jeśli nie wymuszono flagi -t)
    if [ -z "$TYP" ]; then
      LOWER_Z=$(printf '%s' "$ZADANIE" | tr '[:upper:]' '[:lower:]')
      case "$LOWER_Z" in
        *usuń*|*skasuj*|*wyczyść*|*delete*|*clean*|*remove*|*rm\ *)
          TYP="czyszczenie"
          ;;
        *zmień*nazw*|*zmien*nazw*|*rename*repo*)
          TYP="github-rename"
          ;;
        *wypchnij*|*push*|*sync*|*commit*|*wyślij*git*|*wypchnij*git*)
          TYP="git-push"
          ;;
        *obserwuj*|*monitor*|*watch*|*ping*)
          TYP="obserwuj"
          ;;
        *handover*|*przekaż*)
          TYP="handover"
          ;;
        *)
          TYP="github-projekt"
      esac
    fi
    TID="t$(date +%s)"
    mkdir -p "$PROJECT_DIR/tasks" "$PROJECT_DIR/log"
    touch "$PROJECT_DIR/log/evolution.log" "$DONE" 2>/dev/null || true
    echo "✓ Dodano zadanie [$TID] (typ: $TYP): $ZADANIE"
    # Dopisanie do inbox.yaml
    if [ -f "$INBOX" ] && [ -w "$INBOX" ]; then
      printf -- "- id: %s\n  typ: %s\n  z: %s\n" "$TID" "$TYP" "$ZADANIE" >> "$INBOX"
    else
      curl -s -X POST http://localhost:8077/tasks \
        -H "Content-Type: application/json" \
        -d "{\"id\":\"$TID\",\"typ\":\"$TYP\",\"z\":\"$ZADANIE\"}" >/dev/null || true
    fi

    if [ "$FOLLOW" = "1" ]; then
      echo "→ Śledzenie wykonania zadania [$TID] na żywo (Ctrl+C aby odpiąć podgląd):"
      echo ""
      tail -n 0 -f "$PROJECT_DIR/log/evolution.log" &
      TAIL_PID=$!
      cleanup_tail(){
        kill $TAIL_PID 2>/dev/null || true
        wait $TAIL_PID 2>/dev/null || true
      }
      trap cleanup_tail INT TERM EXIT

      while kill -0 $TAIL_PID 2>/dev/null; do
        if grep -q "id: $TID" "$DONE" 2>/dev/null; then
          sleep 1
          cleanup_tail
          echo ""
          # Walidacja Definition of Done (DoD)
          if python3 "$PROJECT_DIR/scripts/dod_validator.py" "$TID" "$TYP" "$ZADANIE"; then
            echo "\033[32m✓ Zadanie [$TID] wykonane i zweryfikowane pomyślnie (Definition of Done: PASS)!\033[0m"
          else
            echo "\033[31m✗ OSTRZEŻENIE: Proces [$TID] zakończył pracę, ale Definition of Done (DoD) NIESPEŁNIONE!\033[0m"
            echo "Uruchom: taskand twin $TID \"$ZADANIE\" w celu zbadania w Digital Twin."
            exit 1
          fi
          break
        fi
        sleep 0.5
      done
      trap - INT TERM EXIT
    fi
    ;;
  clean|cleanup)
    shift || true
    "$0" add -t czyszczenie "${*:-usuń zbędny podkatalog taskand i duplikaty}"
    ;;
  tasks|list)
    echo "=== Oczekujące zadania ($INBOX) ==="
    if [ -s "$INBOX" ]; then cat "$INBOX"; else echo "(brak zadań w kolejce)"; fi
    echo ""
    echo "=== Wykonane zadania ($DONE) ==="
    if [ -s "$DONE" ]; then cat "$DONE"; else echo "(brak wykonanych zadań)"; fi
    ;;
  logs|log)
    shift || true
    docker compose -f "$PROJECT_DIR/docker-compose.yaml" logs -f "${@:-nucleus}"
    ;;
  ps|status)
    docker compose -f "$PROJECT_DIR/docker-compose.yaml" ps
    ;;
  up|start)
    docker compose -f "$PROJECT_DIR/docker-compose.yaml" up -d
    ;;
  down|stop)
    docker compose -f "$PROJECT_DIR/docker-compose.yaml" down
    ;;
  restart)
    docker compose -f "$PROJECT_DIR/docker-compose.yaml" restart
    ;;
  history|hist)
    shift || true
    python3 "$PROJECT_DIR/scripts/history.py" list
    ;;
  rollback|revert)
    shift
    ID="${1:-}"
    if [ -z "$ID" ]; then
      echo "Błąd: podaj ID migawki do przywrócenia, np.: taskand rollback snap-t1789203598"
      exit 1
    fi
    python3 "$PROJECT_DIR/scripts/history.py" rollback "$ID"
    ;;
  twin|test-twin)
    shift
    ID="${1:-}"
    if [ -z "$ID" ]; then
      echo "Użycie: taskand twin <ID_ZADANIA> [opis]"
      echo "Przykład: taskand twin t1789204317 \"wypchnij zmiany na github\""
      exit 1
    fi
    shift
    DESC="${*:-zadanie}"
    python3 "$PROJECT_DIR/scripts/digital_twin.py" "$ID" "$DESC"
    ;;
  snapshot|backup)
    shift || true
    python3 "$PROJECT_DIR/scripts/history.py" snapshot "${1:-taskand}" "${2:-Ręczna migawka stanu}"
    ;;
  show|inspect|info)
    shift || true
    python3 "$PROJECT_DIR/scripts/history.py" show "${1:-}"
    ;;
  web|landing)
    shift || true
    sh "$PROJECT_DIR/serve.sh" "${1:-8080}"
    ;;
  help|-h|--help|"")
    echo "taskand v1.4 — federacyjny system organizmów sterowany konwersacyjnie"
    echo ""
    echo "Użycie: taskand <organizm|komenda> [argumenty]"
    echo ""
    echo "Rozmowa z organizmami (Standard v1.4):"
    echo "  taskand dev \"prompt\"       Rozmawiaj z developerem (tworzenie procesów, dozbrajanie usług, codegen)"
    echo "  taskand doc [\"prompt\"]     Rozmawiaj z doctorem (diagnoza zdrowia, samonaprawa, weryfikacja)"
    echo "  taskand sec \"prompt\"       Rozmawiaj z vaultem (zarządzanie sekretami, migracja tokenów LLM, audyt)"
    echo "  taskand chat \"prompt\"      Rozmawiaj z asystentem chat / kolejkowanie zadań"
    echo "  taskand arm <usługa> [port] Szybkie dozbrojenie istniejącej usługi (np. arm nginx 8090)"
    echo ""
    echo "Federacja i procesy URI:"
    echo "  taskand fed                 Lista zarejestrowanych procesów w rejestrach federacji"
    echo "  taskand proc <uri> [data]   Bezpośrednie wykonanie dowolnego procesu proc://"
    echo ""
    echo "Zarządzanie kontenerami i zadaniami:"
    echo "  taskand add \"opis\"          Dodaj zadanie i śledź wykonanie na żywo"
    echo "  taskand add -d \"opis\"       Dodaj zadanie w tle (async)"
    echo "  taskand clean               Uruchom czyszczenie zbędnych plików i duplikatów"
    echo "  taskand history             Wyświetl historię zadań i migawek"
    echo "  taskand twin <id> [opis]    Testuj proces w Digital Twin Sandbox"
    echo "  taskand rollback <snap-id>  Przywróć stan plików z wybranej migawki"
    echo "  taskand snapshot            Utwórz ręczną migawkę stanu plików"
    echo "  taskand logs [usługa]       Śledź logi na żywo"
    echo "  taskand status              Status kontenerów (docker compose ps)"
    echo "  taskand up / down           Uruchom / zatrzymaj środowisko"
    echo "  taskand restart             Zrestartuj kontenery z weryfikacją doctorem"
    echo "  taskand web [port]          Uruchom serwer strony landing"
    echo ""
    echo "Aktualny stan kontenerów:"
    docker compose -f "$PROJECT_DIR/docker-compose.yaml" ps
    ;;
  *)
    echo "Nieznana komenda: $cmd"
    echo "Uruchom 'taskand help' aby zobaczyć dostępne polecenia."
    exit 1
    ;;
esac
