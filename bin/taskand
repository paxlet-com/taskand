#!/usr/bin/env node
// taskand — CLI. Transport: gateway (gdy /healthz odpowiada) albo lokalnie registry/core. Flaga --json: surowa odpowiedź.
import { spawnSync, execFileSync } from 'node:child_process';
import { readFileSync, realpathSync, existsSync } from 'node:fs';
import { randomBytes } from 'node:crypto';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const ROOT = dirname(dirname(realpathSync(fileURLToPath(import.meta.url))));
const REGISTRY = join(ROOT, 'generated/registry/core/taskand.dev/v1/bin.mjs');
const GATEWAY = process.env.TASKAND_GATEWAY || 'http://127.0.0.1:8077';
const argv = process.argv.slice(2);
const asJson = argv.includes('--json');
const [cmd, ...args] = argv.filter(a => a !== '--json');

function loadEnv() {
  const file = join(ROOT, '.env');
  if (!existsSync(file)) return;
  for (const line of readFileSync(file, 'utf8').split('\n')) {
    const m = line.match(/^\s*([A-Z0-9_]+)\s*=\s*(.*?)\s*$/);
    if (m && process.env[m[1]] === undefined) process.env[m[1]] = m[2];
  }
}
loadEnv();
const TOKEN = process.env.TASKAND_AUTH_TOKEN || 'taskand-admin-key';

async function gatewayUp() {
  try {
    return (await fetch(`${GATEWAY}/healthz`, { signal: AbortSignal.timeout(1000) })).ok;
  } catch {
    return false;
  }
}

async function post(path, body) {
  const r = await fetch(`${GATEWAY}${path}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${TOKEN}` },
    body: JSON.stringify(body)
  });
  return r.json();
}

function local(action, payload) {
  const r = spawnSync('node', [REGISTRY], { input: JSON.stringify({ action, ...payload }), encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 });
  try {
    return JSON.parse(r.stdout);
  } catch {
    return { ok: false, error: r.stderr || 'registry/core: brak odpowiedzi' };
  }
}

// Akcja rejestru: przez gateway (z autoryzacją) lub lokalnie
async function reg(action, payload = {}) {
  if (!(await gatewayUp())) return local(action, payload);
  if (action === 'call') return (await post('/api/proc/call', { uri: payload.uri, data: payload.input, timeout: 900 })).result;
  const r = await post('/api/registry', { action, ...payload });
  return r.result || r;
}

async function chat(organism, message) {
  if (await gatewayUp()) return post('/api/chat', { message, organism });
  return local('call', { uri: 'proc://taskand.dev/dev/chat/v1', input: { message, organism }, timeout_ms: 900000 });
}

const print = (out, human) => {
  console.log(asJson || !human ? JSON.stringify(out, null, 2) : human(out));
  process.exitCode = out?.ok === false ? 1 : 0;
};

// ── Powoływanie węzłów (occupy): replikacja operatorska przez SSH, nigdy autonomiczna ──
// Manifest = jedno źródło prawdy o plikach węzła; @secret pomijane bez --with-secrets.
function readManifest(withSecrets) {
  const paths = [];
  for (const line of readFileSync(join(ROOT, 'bin/bootstrap.manifest'), 'utf8').split('\n')) {
    const t = line.trim();
    if (!t || t.startsWith('#')) continue;
    if (t.startsWith('@secret ')) { if (withSecrets) paths.push(t.slice(8).trim()); }
    else paths.push(t);
  }
  return paths;
}

// Prawdopodobny adres LAN mastera (pomija mosty docker/libvirt) — podpowiedź do handshake; nadpisywalny --master
function localLanIp() {
  try {
    const ips = execFileSync('hostname', ['-I'], { encoding: 'utf8' }).trim().split(/\s+/);
    const bridge = /^(172\.(1[6-9]|2\d|3[01])\.|192\.168\.(122|144|192|208|240)\.|10\.(42|64|201|240|250)\.)/;
    return ips.find(ip => /^\d+\.\d+\.\d+\.\d+$/.test(ip) && !bridge.test(ip)) || ips[0] || 'MASTER_IP';
  } catch { return 'MASTER_IP'; }
}

async function waitHealthz(url, ms = 45000) {
  const t0 = Date.now();
  while (Date.now() - t0 < ms) {
    try {
      const r = await fetch(`${url}/healthz`, { signal: AbortSignal.timeout(2000) });
      if (r.ok) return await r.json();
    } catch { /* jeszcze nie wstał */ }
    await new Promise(r => setTimeout(r, 2000));
  }
  return null;
}

const COMMANDS = {
  async proc([uri, data = '{}']) {
    print(await reg('call', { uri, input: JSON.parse(data) }));
  },
  async status() {
    const up = await gatewayUp();
    const d = await reg('call', { uri: 'proc://taskand.dev/doctor/diagnose/v1', input: {} });
    print(d, o => [`gateway: ${up ? GATEWAY : 'OFFLINE (tryb lokalny)'}`, ...(o.details || [o.error])].join('\n'));
  },
  async procs([organism]) {
    print(await reg('list', { organism }), o => (o.processes || []).map(p => `${p.status.padEnd(10)} ${p.uri}  ${p.desc}`).join('\n') || o.error);
  },
  async approve([uri]) {
    print(await reg('approve', { uri }), o => (o.ok ? `✓ ${uri} → active` : `✗ ${o.error}`));
  },
  async deprecate([uri]) {
    print(await reg('deprecate', { uri }), o => (o.ok ? `✓ ${uri} → deprecated` : `✗ ${o.error}`));
  },
  async verify() {
    print(await reg('verify'), o => (o.ok ? `✓ ${o.checked} pakietów zgodnych z bindingHash` : `✗ zmienione: ${(o.broken || []).join(', ') || o.error}`));
  },
  async pull([peer, token]) {
    print(await reg('pull', { peer, token }), o => (o.ok ? [`${o.remoteNode}: ${o.offered} oferowanych, ${o.imported} zaimportowanych (candidate)`, ...o.report.filter(r => r.result !== 'same').map(r => `  ${r.result} ${r.uri} ${r.reason || ''}`)].join('\n') : `✗ ${o.error}`));
  },
  async heal([flag]) {
    const out = await reg('call', { uri: 'proc://taskand.dev/doctor/heal/v1', input: { run: flag !== '--plan' } });
    print(out, o => o.reply || `✗ ${o.error}`);
  },
  async log([n = '20']) {
    const file = join(ROOT, 'log/events.jsonl');
    console.log(existsSync(file) ? readFileSync(file, 'utf8').trim().split('\n').slice(-Number(n)).join('\n') : 'Brak zdarzeń.');
  }
};
COMMANDS.fed = COMMANDS.procs;
COMMANDS.health = COMMANDS.status;

const HELP = `taskand — organizmy wywoływane przez rejestr (URI + JSON)

  taskand <organizm> "<zadanie>"   dev | doc | sec | hw | file | browser | admin | <dowolny powołany>
  taskand proc <uri> ['<json>']    bezpośrednie wywołanie procesu proc://
  taskand procs [organizm]         procesy w rejestrze (status, URI, opis)
  taskand approve <uri>            candidate → active (wyewoluowane / pobrane od peerów)
  taskand deprecate <uri>          wycofanie procesu
  taskand verify                   integralność pakietów (bindingHash)
  taskand pull <http://peer:8077> [token]   pobranie brakujących pakietów od węzła peer
  taskand status                   diagnoza usług i rejestru
  taskand heal [--plan]            samonaprawa: recepty organizmów wg policy.healing, reszta dla człowieka
  taskand log [n]                  dziennik zdarzeń (CloudEvents)
  --json                           surowa odpowiedź JSON`;

if (!cmd || cmd === 'help' || cmd === '--help') {
  console.log(HELP);
} else if (COMMANDS[cmd]) {
  await COMMANDS[cmd](args);
} else if (/^[a-z0-9][a-z0-9-]*$/.test(cmd)) {
  const out = await chat(cmd, args.join(' ') || 'status');
  print(out, o => o.reply || `✗ ${o.error}`);
} else {
  console.log(HELP);
  process.exitCode = 2;
}
