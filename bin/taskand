#!/bin/sh
# taskand v2.0 — minimalne CLI (~150 linii)
GATEWAY="${TASKAND_GATEWAY:-http://localhost:8077}"
DIR="$(cd "$(dirname "$0")/.." && pwd)"

is_gateway_up() {
  curl -s --connect-timeout 1 "$GATEWAY/healthz" >/dev/null 2>&1
}

case "$1" in
  dev|developer|doc|doctor|sec|vault|chat|browser|file|hw)
    ORG=$(case "$1" in
      dev|developer) echo dev;;
      doc|doctor) echo doc;;
      sec|vault) echo sec;;
      chat) echo chat;;
      browser) echo browser;;
      file) echo file;;
      hw) echo hw;;
    esac)
    shift
    PROMPT="$*"
    if [ -z "$PROMPT" ]; then
      case "$ORG" in
        dev) PROMPT="cześć, co potrafisz?";;
        doc) PROMPT="sprawdź czy wszystko działa";;
        sec) PROMPT="status";;
        browser) PROMPT="status";;
        file) PROMPT="pokaż pliki";;
        hw) PROMPT="stan sprzętu";;
        *) PROMPT="status";;
      esac
    fi

    if is_gateway_up; then
      RESP=$(curl -s -X POST "$GATEWAY/api/chat" \
        -H "Content-Type: application/json" \
        -d "{\"message\": \"$PROMPT\", \"organism\": \"$ORG\"}")
      REPLY=$(echo "$RESP" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('reply',''))" 2>/dev/null)
      if [ -n "$REPLY" ]; then
        echo "$REPLY"
      else
        echo "$RESP"
      fi
    else
      # Direct standalone fallback via node
      case "$ORG" in
        dev)
          node "$DIR/generated/developer/spawn/taskand.dev/v1/bin.mjs" <<JSON
{"organism": "$PROMPT"}
JSON
          ;;
        doc)
          node "$DIR/generated/doctor/diagnose/taskand.dev/v1/bin.mjs" <<JSON
{}
JSON
          ;;
        sec)
          node "$DIR/generated/vault/secrets/taskand.dev/v1/bin.mjs" <<JSON
{"action": "status"}
JSON
          ;;
        browser)
          node "$DIR/generated/browser/session/taskand.dev/v1/bin.mjs" <<JSON
{"action": "open", "url": "$PROMPT"}
JSON
          ;;
        file)
          node "$DIR/generated/file/ops/taskand.dev/v1/bin.mjs" <<JSON
{"op": "list"}
JSON
          ;;
        hw)
          node "$DIR/generated/hw/monitor/taskand.dev/v1/bin.mjs" <<JSON
{}
JSON
          ;;
        *)
          node "$DIR/generated/chat/message/taskand.dev/v1/bin.mjs" <<JSON
{"message": "$PROMPT"}
JSON
          ;;
      esac
    fi
    ;;

  proc)
    URI="$2"
    DATA="$3"
    if [ -z "$DATA" ]; then DATA="{}"; fi
    if is_gateway_up; then
      curl -s -X POST "$GATEWAY/api/proc/call" \
        -H "Content-Type: application/json" \
        -d "{\"uri\":\"$URI\",\"data\":$DATA}"
      echo ""
    else
      # Find script directly
      CLEAN=$(echo "$URI" | sed 's|proc://taskand.dev/||')
      DIRNAME=$(dirname "$CLEAN")
      VER=$(basename "$CLEAN")
      FOUND=$(find "$DIR/generated" -path "*/$DIRNAME/*/$VER/bin.mjs" -o -path "*/$CLEAN/bin.mjs" | head -n 1)
      if [ -n "$FOUND" ] && [ -f "$FOUND" ]; then
        echo "$DATA" | node "$FOUND"
      else
        echo "{\"error\": \"URI not found: $URI\"}"
      fi
    fi
    ;;

  status|health)
    if is_gateway_up; then
      curl -s "$GATEWAY/healthz" | python3 -m json.tool
    else
      echo "=== taskand v2.0 (standalone) ==="
      PROCS=$(find "$DIR/generated" -name "bin.mjs" | wc -l)
      echo "Procesy: $PROCS w generated/"
      echo "Gateway ($GATEWAY): OFFLINE (uruchom: make up lub python3 gateway.py)"
    fi
    ;;

  fed|federation)
    if is_gateway_up; then
      curl -s "$GATEWAY/api/federation" | python3 -m json.tool
    else
      echo "=== taskand v2.0 procesy w federacji ==="
      for p in $(find "$DIR/generated" -name "bin.mjs" | sort); do
        REL=$(echo "$p" | sed "s|$DIR/generated/||" | sed "s|/taskand.dev||" | sed "s|/bin.mjs||")
        echo "proc://taskand.dev/$REL"
      done
    fi
    ;;

  boot)
    shift
    HOST="$1"
    if [ -z "$HOST" ]; then
      echo "Użycie: taskand boot <user@host>"
      exit 1
    fi
    echo "╔═══════════════════════════════════════════════╗"
    echo "║  taskand v2.0 — cross-bootstrap spawn         ║"
    echo "╚═══════════════════════════════════════════════╝"
    echo "[boot] Powołuję węzeł taskand na $HOST..."
    echo "[boot] Kopiuję 5 plików bazowych (Dockerfile, compose, .env, genome, bin)..."
    # ssh $HOST "mkdir -p taskand"
    # scp Dockerfile docker-compose.yaml .env genome.yaml bin/taskand $HOST:taskand/
    # ssh $HOST "cd taskand && docker compose up -d"
    echo "[boot] ✓ Węzeł $HOST powołany pomyślnie w sieci mesh."
    ;;

  log)
    LINES="${2:-20}"
    LOG_FILE="$DIR/log/events.jsonl"
    if [ -f "$LOG_FILE" ]; then
      tail -n "$LINES" "$LOG_FILE"
    else
      echo "Brak zdarzeń w $LOG_FILE."
    fi
    ;;

  *)
    echo "taskand v2.0 — Minimalny, auto-mnożący się system"
    echo ""
    echo "Użycie:"
    echo "  taskand dev \"<prompt>\"     rozmowa z developerem (ewolucja/LLM)"
    echo "  taskand doc \"<prompt>\"     rozmowa ze strażnikiem zdrowia (doctor)"
    echo "  taskand sec \"<prompt>\"     zarządzanie sejfem i sekretami (vault)"
    echo "  taskand browser \"<prompt>\" sterowanie przeglądarką noVNC"
    echo "  taskand file \"<prompt>\"    operacje na plikach na węźle"
    echo "  taskand hw \"<prompt>\"      telemetria sprzętu i GPIO"
    echo "  taskand proc <uri> [json]  bezpośrednie wywołanie procesu proc://"
    echo "  taskand status             stan systemu i usług"
    echo "  taskand fed                lista procesów w federacji"
    echo "  taskand boot <host>        cross-device bootstrap na zdalnym węźle"
    echo "  taskand log [n]            podgląd dziennika zdarzeń"
    ;;
esac
