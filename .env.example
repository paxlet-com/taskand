# taskand · .env.example — kontrakt runtime (GLM-5.3 + gateway)
# skopiuj do .env i wpisz własne sekrety. Plik .env jest ignorowany przez Git.
# Puste TASKAND_LLM_API_KEY uruchamia wbudowane szablony bez wywołania LLM.
TASKAND_LLM_API_KEY=
TASKAND_LLM_ENDPOINT=https://api.z.ai/api/paas/v4/chat/completions
TASKAND_LLM_MODEL=glm-5.3

# Autoryzacja HTTP/CLI. Puste pole pozostawia lokalny grant z grants.yaml
# (taskand-admin-key); dla LAN/VPS wpisz długi losowy token.
TASKAND_AUTH_TOKEN=
TASKAND_BIND=127.0.0.1

# Transport przeglądarki Digital Twin (wartości domyślne dla make up).
TASKAND_BROWSER_CDP=http://127.0.0.1:9222
TASKAND_BROWSER_NOVNC=http://127.0.0.1:3010

# Opcjonalne sterowanie modelem i sejfem sekretów.
TASKAND_LLM_REASONING=
# Wygeneruj dopiero przy użyciu vault: openssl rand -hex 32
TASKAND_VAULT_KEY=

# Opcjonalne ustawienia węzła, ścieżek Compose i klienta CLI.
TASKAND_NODE=
TASKAND_DEBUG=
TASKAND_DATA_ROOT=.
TASKAND_GENERATED_ROOT=./generated
TASKAND_GATEWAY=http://127.0.0.1:8077
